# GEMINI_API_KEY: Server-side Google Gemini API key for AI Human Identity Classification.
# Configured automatically in Settings > Secrets; never expose via NEXT_PUBLIC_.
GEMINI_API_KEY=""

# APP_URL: The URL where this application is hosted.
# Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

# CHROMIUM_PATH: Optional path to a Chromium/Chrome binary for headless Playwright
# fallback extraction when Instagram blocks HTTP-only TLS scraping.
# CHROMIUM_PATH="/usr/bin/chromium"

